<article class="comment-card" id="comment-<%= comment.id %>">
  <div class="d-flex justify-content-between align-items-start gap-3">
    <div>
      <strong><%= comment.user&.name || "Unknown user" %></strong>
      <small class="text-muted d-block"><%= l(comment.created_at, format: :long) %></small>
    </div>

    <% if user_signed_in? && policy(comment).destroy? %>
      <%= button_to "Delete", post_comment_path(comment.post, comment), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Delete this comment and its replies?" } } %>
    <% end %>
  </div>

  <div class="mt-2"><%= simple_format(comment.body) %></div>

  <% if user_signed_in? %>
    <details class="comment-reply-form mt-3">
      <summary class="btn btn-sm btn-outline-secondary">Reply</summary>
      <div class="mt-3">
        <%= render "comments/form", post: comment.post, parent_comment: comment %>
      </div>
    </details>
  <% else %>
    <%= link_to "Sign in to reply", new_user_session_path, class: "btn btn-sm btn-link px-0" %>
  <% end %>

  <% if comment.replies.any? %>
    <div class="comment-replies mt-3">
      <%= render partial: "comments/comment", collection: comment.replies.includes(:user).order(created_at: :asc), as: :comment %>
    </div>
  <% end %>
</article>
