<% form_url = admin_post_request? ? (post.persisted? ? admin_post_path(post) : admin_posts_path) : nil %>
<%= form_with model: post, url: form_url do |form| %>
  <% if post.errors.any? %>
    <div role="alert">
      <h2><%= pluralize(post.errors.count, "error") %> prevented this post from being saved:</h2>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p class="mb-3"><%= form.label :title, class: "form-label" %><br><%= form.text_field :title, required: true, class: "form-control w-100" %></p>
  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.rich_text_area :description, required: true %>
  </div>
  <p class="mb-3"><%= label_tag :author, "Author", class: "form-label" %><br><%= text_field_tag :author, current_user.name, readonly: true, class: "form-control w-100" %></p>
  <p><%= form.check_box :published %> <%= form.label :published %></p>
  <%= form.submit %>
<% end %>
