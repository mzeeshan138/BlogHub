<%= form_with model: post do |form| %>
  <% if post.errors.any? %>
    <div role="alert">
      <h2><%= pluralize(post.errors.count, "error") %> prevented this post from being saved:</h2>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p><%= form.label :title %><br><%= form.text_field :title, required: true %></p>
  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.rich_text_area :description, required: true %>
  </div>
  <p><%= form.label :user_id, "Author" %><br><%= form.collection_select :user_id, users, :id, :name, { prompt: "Choose an author" }, required: true %></p>
  <p><%= form.check_box :published %> <%= form.label :published %></p>
  <%= form.submit %>
<% end %>
