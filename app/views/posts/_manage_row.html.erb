<tr id="<%= dom_id(post, :manage) %>">
  <td><%= link_to post.title, admin_post_path(post), class: "text-decoration-none fw-semibold" %></td>
  <td><%= post.user&.name || post.user&.email || "Unknown" %></td>
  <td>
    <span class="badge <%= post.published? ? 'bg-success' : 'bg-secondary' %>">
      <%= post.published? ? "Published" : "Draft" %>
    </span>
  </td>
  <td><%= l(post.created_at, format: :short) %></td>
  <td class="text-end">
    <div class="d-flex justify-content-end gap-2 flex-wrap">
      <%= link_to "Show", admin_post_path(post), class: "btn btn-sm btn-outline-secondary" %>
      <%= link_to "Edit", admin_edit_post_path(post), class: "btn btn-sm btn-outline-primary" %>
      <%= button_to(post.published? ? "Unpublish" : "Publish", admin_toggle_published_post_path(post), method: :patch, class: "btn btn-sm btn-outline-secondary") %>
      <%= button_to "Delete", admin_post_path(post), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Are you sure you want to delete this post?" } } %>
    </div>
  </td>
</tr>
