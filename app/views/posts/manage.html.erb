<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">Manage posts</h1>
    <p class="text-muted mb-0">Review, edit, publish, and delete posts.</p>
  </div>
  <%= link_to "New post", admin_new_post_path, class: "btn btn-primary" %>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-striped mb-0 align-middle">
      <thead class="table-heading">
        <tr>
          <th>Title</th>
          <th>Author</th>
          <th>Status</th>
          <th>Created</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <%= render "manage_row", post: post %>
        <% end %>
        <% if @posts.empty? %>
          <tr><td colspan="5" class="text-center text-muted py-4">No posts yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
