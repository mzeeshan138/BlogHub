<% content_for :title, t("posts.index.title") %>

<h1><%= t("posts.index.title") %></h1>

<p><%= link_to t("posts.new.link"), new_post_path %></p>

<% if @posts.any? %>
  <%= render partial: "post", collection: @posts, layout: "post_card", spacer_template: "post_spacer" %>
<% else %>
  <p><%= t("posts.index.empty") %></p>
<% end %>
