<% content_for :title, @post.title %>

<div class="card shadow-sm border-0">
  <div class="card-body p-4 p-lg-5">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
      <div>
        <span class="badge bg-primary-subtle text-primary-emphasis mb-2"><%= publication_status(@post) %></span>
        <h1 class="mb-1"><%= @post.title %></h1>
        <p class="text-muted mb-0">By <%= @post.user.name %> · <%= @post.created_at.strftime("%b %d, %Y") %></p>
      </div>

      <% if user_signed_in? %>
        <div class="d-flex gap-2 flex-wrap">
          <%= link_to "Edit", edit_post_path(@post), class: "btn btn-outline-primary btn-sm" %>
          <%= button_to "Delete", post_path(@post), method: :delete, class: "btn btn-outline-danger btn-sm", form: { data: { turbo_confirm: "Are you sure you want to delete this post?" } } %>
        </div>
      <% end %>
    </div>

    <div class="fs-5 lh-lg text-secondary mb-4">
      <%= simple_format(@post.description) %>
    </div>

    <% if user_signed_in? %>
      <%= render "published_toggle", post: @post %>
    <% end %>

    <div class="mt-4">
      <%= link_to "Back to posts", posts_path, class: "btn btn-link px-0 text-decoration-none" %>
    </div>
  </div>
</div>

<section class="mt-5">
  <h2 class="h3 mb-3">Comments</h2>
  <%= render "comments/comments", comments: @comments %>
</section>
