<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N0sY1" crossorigin="anonymous"></script>
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark blog-header shadow-sm sticky-top">
      <div class="container justify-content-between">
        <%= link_to "BlogHub", root_path, class: "navbar-brand fw-bold" %>
        <div class="d-flex align-items-center gap-2">
          <% if user_signed_in? %>
              <div class="dropdown" data-controller="profile-dropdown" data-action="click@window->profile-dropdown#closeIfOutside keydown.esc@window->profile-dropdown#close">
                <button class="btn blog-profile-button dropdown-toggle d-flex align-items-center gap-2 profile-menu" type="button" aria-expanded="false" data-action="profile-dropdown#toggle" data-profile-dropdown-target="button">
                  <% if current_user.avatar.attached? && current_user.avatar.blob.persisted? %>
                    <%= image_tag current_user.avatar, class: "profile-avatar", width: 36, height: 36, alt: "Profile image for #{current_user.name}" %>
                  <% else %>
                    <span class="profile-avatar profile-avatar-placeholder" role="img" aria-label="Default profile image">&#128100;</span>
                  <% end %>
                  <span class="d-none d-sm-inline"><%= current_user.name.presence || current_user.email %></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm" data-profile-dropdown-target="menu">
                  <li><h6 class="dropdown-header"><%= current_user.email %></h6></li>
                  <li><%= link_to "View profile", edit_user_registration_path, class: "dropdown-item" %></li>
                  <% if current_user.admin? %>
                    <li><%= link_to "Dashboard", admin_dashboard_path, class: "dropdown-item" %></li>
                  <% end %>
                  <li><hr class="dropdown-divider"></li>
                  <li><%= button_to "Logout", destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" %></li>
                </ul>
              </div>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "btn btn-outline-light btn-sm" %>
            <%= link_to "Sign up", new_user_registration_path, class: "btn btn-light btn-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="<%= admin_area? ? 'container-fluid px-0 admin-main' : 'container py-4' %>">
      <% if admin_area? %>
        <div class="admin-shell">
          <aside class="admin-sidebar" aria-label="Admin navigation">
            <div class="admin-sidebar-heading">Administration</div>
            <nav class="nav flex-column gap-1">
              <%= link_to admin_dashboard_path, class: "admin-sidebar-link #{'active' if current_page?(admin_dashboard_path)}" do %>
                <span class="sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5v8a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg></span><span>Dashboard</span>
              <% end %>
              <%= link_to admin_new_post_path, class: "admin-sidebar-link #{'active' if current_page?(admin_new_post_path)}" do %>
                <span class="sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span><span>New post</span>
              <% end %>
              <%= link_to admin_users_path, class: "admin-sidebar-link #{'active' if current_page?(admin_users_path) || request.path.start_with?('/admin/users/')}" do %>
                <span class="sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 20c.7-3.4 3.1-5 7-5s6.3 1.6 7 5"/></svg></span><span>Manage users</span>
              <% end %>
              <%= link_to admin_posts_path, class: "admin-sidebar-link #{'active' if current_page?(admin_posts_path)}" do %>
                <span class="sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="16" rx="1"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span><span>Manage posts</span>
              <% end %>
              <%= button_to destroy_user_session_path, method: :delete, class: "admin-sidebar-link admin-sidebar-button" do %>
                <span class="sidebar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h5M15 16l4-4-4-4M19 12H9"/></svg></span><span>Logout</span>
              <% end %>
            </nav>
          </aside>

          <section class="admin-content">
            <% flash.each do |type, message| %>
              <% next if message.blank? %>
              <div class="alert alert-<%= flash_class(type) %> alert-dismissible fade show" role="alert">
                <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% end %>
            <%= yield %>
          </section>
        </div>
      <% else %>
        <% flash.each do |type, message| %>
          <% next if message.blank? %>
          <div class="alert alert-<%= flash_class(type) %> alert-dismissible fade show" role="alert">
            <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
        <%= yield %>
      <% end %>
    </main>

    <footer class="border-top bg-white mt-5">
      <div class="container py-3 text-center text-muted">
        BlogHub © <%= Time.current.year %>
      </div>
    </footer>
  </body>
</html>
