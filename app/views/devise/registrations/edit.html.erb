<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-lg-5">
          <h2 class="mb-4 text-center">Edit profile</h2>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true }, data: { controller: "avatar-preview" }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :name, class: "form-label" %>
              <%= f.text_field :name, autofocus: true, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, autocomplete: "email", class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :avatar, "Profile image", class: "form-label" %>
              <div class="avatar-preview mb-3" aria-live="polite">
                <% if resource.avatar.attached? && resource.avatar.blob.persisted? %>
                  <%= image_tag resource.avatar, class: "avatar-image", width: 160, height: 160, alt: "Current profile image", data: { avatar_preview_target: "image" } %>
                  <div class="avatar-placeholder d-none" data-avatar-preview-target="placeholder" aria-hidden="true">&#128100;</div>
                <% else %>
                  <%= tag.img class: "avatar-image d-none", width: 160, height: 160, alt: "Selected profile image", data: { avatar_preview_target: "image" } %>
                  <div class="avatar-placeholder" data-avatar-preview-target="placeholder" role="img" aria-label="Default profile image">&#128100;</div>
                <% end %>
              </div>
              <%= f.file_field :avatar, accept: "image/png,image/jpeg,image/gif", class: "visually-hidden", data: { avatar_preview_target: "input", action: "change->avatar-preview#update" } %>
              <%= f.label :avatar, "Upload image", class: "btn btn-outline-primary" %>
              <div class="form-text">PNG, JPEG, or GIF up to 5 MB.</div>
            </div>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-warning">Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
            <% end %>

            <div class="mb-3">
              <%= f.label :password, class: "form-label" %>
              <small class="text-muted">(leave blank if you do not want to change it)</small>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
              <% if @minimum_password_length %>
                <small class="form-text text-muted"><%= @minimum_password_length %> characters minimum</small>
              <% end %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :current_password, class: "form-label" %>
              <small class="text-muted">(we need your current password to confirm your changes)</small>
              <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control" %>
            </div>

            <div class="d-grid">
              <%= f.submit "Update", class: "btn btn-primary" %>
            </div>
          <% end %>

          <hr class="my-4">

          <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="text-danger fw-semibold">Unhappy?</div>
            <%= button_to "Cancel my account", registration_path(resource_name), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-outline-danger" %>
          </div>

          <div class="mt-3">
            <%= link_to "Back", :back, class: "link-secondary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
