<% if resource.errors.any? %>
  <% if local_assigns[:flash_errors] %>
    <% flash.now[:alert] = resource.errors.full_messages.to_sentence %>
  <% else %>
    <div id="error_explanation" data-turbo-temporary>
      <% if local_assigns.fetch(:show_heading, true) %>
        <h2><%= I18n.t("errors.messages.not_saved", count: resource.errors.count, resource: resource.class.model_name.human.downcase) %></h2>
      <% end %>
      <ul>
        <% resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<% end %>
