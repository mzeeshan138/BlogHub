<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">Dashboard</h1>
    <p class="text-muted mb-0">Welcome back, <%= current_user.name.presence || current_user.email %>.</p>
  </div>
  <%= link_to "Create post", admin_new_post_path, class: "btn btn-primary" %>
</div>

<div class="row g-3 mb-4">
  <% [["Users", @users_count, admin_users_path], ["All posts", @posts_count, admin_posts_path], ["Published", @published_posts_count, admin_posts_path], ["Drafts", @draft_posts_count, admin_posts_path]].each do |label, count, path| %>
    <div class="col-sm-6 col-xl-3">
      <%= link_to path, class: "text-decoration-none" do %>
        <div class="card dashboard-stat-card shadow-sm h-100">
          <div class="card-body">
            <div class="text-muted small"><%= label %></div>
            <div class="display-6 fw-semibold text-dark"><%= count %></div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="h5 mb-0">Recent posts</h2>
      <%= link_to "View all", admin_posts_path, class: "btn btn-sm btn-outline-primary" %>
    </div>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr><th>Title</th><th>Author</th><th>Status</th><th>Created</th></tr>
        </thead>
        <tbody>
          <% @recent_posts.each do |post| %>
            <tr>
              <td><%= link_to post.title, post_path(post), class: "text-decoration-none fw-semibold" %></td>
              <td><%= post.user&.name || post.user&.email || "Unknown" %></td>
              <td><span class="badge <%= post.published? ? 'bg-success' : 'bg-secondary' %>"><%= post.published? ? "Published" : "Draft" %></span></td>
              <td><%= l(post.created_at, format: :short) %></td>
            </tr>
          <% end %>
          <% if @recent_posts.empty? %>
            <tr><td colspan="4" class="text-center text-muted py-4">No posts yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
